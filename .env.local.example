# Copy this file to .env.local and fill in your keys.

# Option A (recommended if Google Cloud Console blocks you):
# Vercel Dashboard → AI Gateway → API Keys → create key
AI_GATEWAY_API_KEY=

# Option B: Google AI Studio key (https://aistudio.google.com/apikey)
# New keys may start with AQ... instead of AIzaSy — that is normal in 2026.
GOOGLE_GENERATIVE_AI_API_KEY=

# Gmail OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Tripo3D (https://platform.tripo3d.ai) — generación de modelos 3D desde una imagen.
# Pago por generación (~$0.30 USD c/u); nuevas cuentas reciben créditos gratis de prueba.
TRIPO3D_API_KEY=

# Candado de acceso (HTTP Basic Auth) para /consultoria y sus APIs — datos confidenciales de clientes.
CONSULTORIA_AUTH_USER=
CONSULTORIA_AUTH_PASSWORD=

# Separa el despliegue en dos sitios independientes desde el mismo código (ver middleware.ts).
# "bruna" = solo Maker 3D, Consultoría no existe (404). "consultoria" = solo Consultoría.
# Déjala vacía en local para tener ambas secciones activas al mismo tiempo.
APP_MODE=
